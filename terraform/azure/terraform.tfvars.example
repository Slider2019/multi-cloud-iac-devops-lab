# Copy this file to terraform.tfvars and fill in the values.
# NEVER commit terraform.tfvars to version control.

location             = "eastus"
resource_group_name  = "resourcegroupclaudecode"
environment          = "Dev"
project              = "ClaudeCodeLab"
owner                = "DiegoRojas"

# Replace with your real public IP (e.g. "203.0.113.10/32")
allowed_ip           = "0.0.0.0/32"

# Sensitive — provide via environment variables or a secrets manager in CI/CD
# TF_VAR_vm_admin_username / TF_VAR_vm_admin_password
vm_admin_username    = "CHANGE_ME"
vm_admin_password    = "CHANGE_ME_Min12chars!1A"

# Must be globally unique across all Azure accounts (3-24 lowercase alphanumeric)
storage_account_name = "saclaudecode1987"
