# Copy this file to terraform.tfvars and fill in the values.
# NEVER commit terraform.tfvars to version control.

aws_region        = "us-east-1"
environment       = "Dev"
project           = "ClaudeCodeLab"
owner             = "DiegoRojas"

# Replace with your real public IP (e.g. "203.0.113.10/32")
allowed_ip        = "0.0.0.0/32"

availability_zone = "us-east-1a"

# Amazon Linux 2023 AMI for us-east-1 — update for other regions
ami_id            = "ami-0c02fb55956c7d316"
instance_type     = "t3.micro"

# Name of an existing EC2 key pair in your AWS account
# Sensitive — provide via TF_VAR_key_name environment variable
key_name          = "CHANGE_ME"

# Must be globally unique across all AWS accounts
s3_bucket_name    = "claudecodelab-static-website-CHANGE_ME"
